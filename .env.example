# ForgeAI — copy to .env and fill secrets (never commit .env)
# See app/core/config.py for all options

# --- App ---
APP_NAME=ForgeAI
HOST=0.0.0.0
PORT=8000
FORGE_HOME=./data
FORGEAI_CONFIG=
DEFAULT_USER_ID=local
DEFAULT_USER_NAME=Local User
DEFAULT_ROLE=owner

# --- Secrets (use SecretStr — never log) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
API_KEY=

# --- LLM ---
MODEL_NAME=qwen3-vl:2b-thinking
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDERS=
PLANNER_MODE=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_THINK=true
VLLM_BASE_URL=http://localhost:8001/v1

# --- Sandbox ---
SANDBOX_BACKEND=auto
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_NETWORK=false
DOCKER_IMAGE=python:3.11-slim
SANDBOX_FOR_TERMINAL=true
SANDBOX_FOR_PYTHON_SCRIPTS=true
DEFAULT_PROJECT_ROOT=
MAX_WORKSPACE_BYTES=104857600
TASK_WORKERS=2
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Agent ---
AGENT_MAX_STEPS=12
AGENT_AUTO_APPROVE=true
AGENT_APPROVAL_TOOLS=terminal,write_file,patch,browser

# --- Tool timeouts ---
TERMINAL_TIMEOUT_SECONDS=30
TERMINAL_ALLOWLIST=dir,ls,echo,type,cat,pwd,cd,whoami,python,python3,py,pip,pip3,mkdir,rm,rmdir,del,copy,cp,mv,move,git,pytest,node,npm,npx
BROWSER_TIMEOUT_SECONDS=30
BROWSER_MAX_TEXT_CHARS=8000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
